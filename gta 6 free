
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GTA VI - Téléchargement gratuit</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 background:#f4f6f7;
 color:#252525;
 font-family:Arial,sans-serif;
}
header{
 background:white;
 border-bottom:1px solid #ddd;
 padding:17px;
}
.logo{
 max-width:1000px;
 margin:auto;
 color:#20aa40;
 font-size:25px;
 font-weight:bold;
}
.logo span{color:#333}
main{
 max-width:1000px;
 margin:25px auto;
 padding:0 15px;
}
.layout{
 display:grid;
 grid-template-columns:1fr 290px;
 gap:20px;
}
.card{
 background:white;
 border:1px solid #ddd;
 border-radius:6px;
 margin-bottom:18px;
 overflow:hidden;
}
.content{padding:22px}
h1{font-size:25px}
h2{font-size:19px}
.muted{color:#777;font-size:13px;line-height:1.5}
.game{
 display:flex;
 align-items:center;
 gap:18px;
}
.icon{
 width:90px;
 height:90px;
 border-radius:15px;
 background:linear-gradient(135deg,#ec559d,#252653);
 display:grid;
 place-items:center;
 color:white;
 font-size:35px;
 font-weight:bold;
}
.green{
 width:100%;
 padding:15px;
 border:0;
 border-radius:4px;
 background:linear-gradient(#39cf4d,#11972e);
 color:white;
 font-size:16px;
 font-weight:bold;
 cursor:pointer;
 box-shadow:0 2px 0 #087c23;
}
.green:hover{filter:brightness(1.08)}
.section{
 border-top:1px solid #eee;
 padding:20px;
}
.ad{
 display:block;
 width:100%;
 margin:14px 0;
 padding:20px 8px;
 border:2px solid #087e16;
 border-radius:7px;
 background:linear-gradient(#52e900,#12a900);
 color:white;
 font-size:clamp(18px,3vw,29px);
 font-weight:bold;
 text-align:center;
 text-shadow:2px 2px 3px #222;
 box-shadow:inset 0 0 12px #ffffff88,0 2px 5px #999;
 cursor:pointer;
}
.ad.round{
 border-radius:45px;
 background:linear-gradient(#56ed00,#16a500);
}
.ad small{
 display:block;
 font-size:11px;
 text-shadow:none;
 margin-top:5px;
}
.adlabel{
 color:#999;
 font-size:10px;
 letter-spacing:1px;
}
.side{padding:15px}
.page{display:none}
.page.active{display:block}
.note{
 padding:12px;
 margin:15px 0;
 background:#effbef;
 border-left:4px solid #20aa40;
 color:#386b3d;
 font-size:13px;
 line-height:1.5;
}
.file{
 display:flex;
 align-items:center;
 gap:12px;
 padding:15px 0;
 border-bottom:1px solid #eee;
}
.fileicon{font-size:30px}
.fileinfo{flex:1}
.fileinfo small{
 display:block;
 color:#777;
 margin-top:5px;
}
.file button{
 border:1px solid #20aa40;
 color:#159634;
 background:white;
 padding:10px;
 border-radius:4px;
 cursor:pointer;
}
.steps{
 display:flex;
 gap:5px;
 margin-bottom:15px;
}
.steps span{
 flex:1;
 height:4px;
 background:#ddd;
}
.steps span.on{background:#20aa40}
.overlay{
 display:none;
 position:fixed;
 inset:0;
 background:#0009;
 z-index:10;
 align-items:center;
 justify-content:center;
 padding:15px;
}
.overlay.show{display:flex}
.popup{
 background:white;
 width:100%;
 max-width:430px;
 border-radius:7px;
 overflow:hidden;
 box-shadow:0 10px 40px #0007;
 animation:appear .2s;
}
@keyframes appear{
 from{transform:scale(.9);opacity:0}
 to{transform:scale(1);opacity:1}
}
.pophead{
 padding:15px;
 border-bottom:1px solid #ddd;
 font-weight:bold;
}
.close{
 float:right;
 border:0;
 background:none;
 font-size:22px;
 cursor:pointer;
}
.popbody{padding:20px}
.choice{
 border:1px solid #ddd;
 padding:13px;
 margin:10px 0;
 border-radius:4px;
 font-size:13px;
}
.choice b{float:right;color:#20aa40}
footer{
 text-align:center;
 color:#999;
 font-size:11px;
 padding:25px;
}
@media(max-width:750px){
 .layout{grid-template-columns:1fr}
}
</style>
</head>

