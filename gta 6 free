<script>

function go(n){
 for(let i=1;i<=4;i++){
  document.getElementById('p'+i)
   .classList.toggle('active',i===n);

  document.getElementById('s'+i)
   .classList.toggle('on',i<=n);
 }
 window.scrollTo(0,0);
}

function popup(type){

 const title=document.getElementById('popTitle');
 const body=document.getElementById('popBody');

 if(type==='pub'){
  title.textContent='Téléchargement sponsorisé';

  body.innerHTML=`
   <h3>🎉 Offre spéciale !</h3>
   <p class="muted">
    Vous avez trouvé un téléchargement partenaire !
    Enfin... presque.
   </p>

   <div class="choice">
    ⬇ Téléchargement ultra rapide
    <b>PUBLICITÉ</b>
   </div>

   <p class="muted">
    Ceci est une fausse publicité pour la blague.
   </p>

   <button class="green" onclick="closePopup()">
    RETOUR AU SITE
   </button>
  `;
 }else{
  title.textContent='Sélection du serveur';

  body.innerHTML=`
   <h3>Votre fichier est presque prêt</h3>
   <p class="muted">
    Choisissez votre serveur de téléchargement.
   </p>

   <div class="choice">
    🌐 Serveur Vice City
    <b>EN LIGNE</b>
   </div>

   <div class="choice">
    ⚡ Serveur ultra rapide
    <b>EN LIGNE</b>
   </div>

   <button class="green" onclick="closePopup();go(3)">
    LANCER LE TÉLÉCHARGEMENT
   </button>
  `;
 }

 document.getElementById('overlay')
  .classList.add('show');
}

function closePopup(){
 document.getElementById('overlay')
  .classList.remove('show');
}

document.getElementById('overlay')
 .addEventListener('click',function(e){
  if(e.target===this)closePopup();
 });

document.addEventListener('keydown',function(e){
 if(e.key==='Escape')closePopup();
});

function downloadText(filename,content){

 const blob=new Blob([content],{
  type:'text/plain;charset=utf-8'
 });

 const url=URL.createObjectURL(blob);
 const a=document.createElement('a');

 a.href=url;
 a.download=filename;

 document.body.appendChild(a);
 a.click();
 a.remove();

 setTimeout(function(){
  URL.revokeObjectURL(url);
 },1500);
}


function downloadAll(){

 downloadText(
  'GTA6.exe.txt',
  'INSTALLATION GTA VI\n\nÉCHEC DU TÉLÉCHARGEMENT !\n\nErreur 404 : devoir d’allemand détecté.\nRévise plutôt ton vocabulaire !'
 );

 setTimeout(function(){
  downloadText(
   'virus.exe.txt',
   'VIRUS.EXE\n\nSURPRISE !\nCeci est un simple fichier texte.\nAucun virus, aucun danger.\n\nTU T’ES FAIT TROLLER ! 😂\nHerzlichen Glückwunsch!'
  );
 },1000);
}


</script>
